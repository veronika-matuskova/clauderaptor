.credentials.json
settings.local.json
*.bak.*

# Local work: cloned repos and task folders are never committed
repos/*
!repos/.gitkeep
tasks/*
!tasks/.gitkeep

# Skills synced from claude.ai (written by Claude Code via the skills symlink)
claude/skills/synced/

# Themes saved in /theme (Claude Code writes them through the ~/.claude/themes link); only the repo's own are tracked
claude/themes/*
!claude/themes/iris-neon-dark.json
!claude/themes/iris-neon-light.json

# Python bytecode (a review session that imports apps/stats/stats.py would write it)
__pycache__/

# Stats data lives in the state dir (~/.local/state), never in the repo (the pre-commit hook also refuses it)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
events*.jsonl
report.html
