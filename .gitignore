.credentials.json
settings.local.json
*.bak.*

# Local work: cloned repos and task folders are never committed
repos/*
!repos/.gitkeep
tasks/*
!tasks/.gitkeep

# Skills synced from claude.ai (written by Claude Code via the skills symlink)
claude/skills/synced/

# Python bytecode (a review session that imports scripts/stats/stats.py would write it)
__pycache__/

# Stats data lives in the state dir (~/.local/state), never in the repo (the pre-commit hook also refuses it)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
events*.jsonl
report.html
